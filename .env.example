DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=junglegaming
DATABASE_PASSWORD=junglegaming
DATABASE_NAME=junglegaming

SQS_ENDPOINT=http://localhost:4566
SQS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_INBOUND_QUEUE_NAME=wager-transactions.fifo
SQS_OUTBOUND_QUEUE_NAME=wager-events.fifo

PORT=3000

# Gate positivo explícito — ausente/qualquer valor != 'true' mantém os 4
# componentes assíncronos (WagerTransactionConsumer, OutboxPublisherRuntime,
# PendingReferenceRuntime, DlqGaugeRuntime) desligados. Nunca ligado por
# padrão — testes de integração que sobem a AppModule via app.init() nunca
# precisam de LocalStack alcançável (ARCHITECTURE.md seção 30). O serviço
# `app` do docker-compose sobrescreve isso para "true" (ARCHITECTURE.md
# seção 31).
# START_BACKGROUND_WORKERS=true

# SQS_CONSUMER_WAIT_TIME_SECONDS=10
# OUTBOX_PUBLISHER_INTERVAL_MS=5000
# OUTBOX_PUBLISHER_BATCH_SIZE=10
# PENDING_REFERENCE_WORKER_INTERVAL_MS=5000
# DLQ_GAUGE_INTERVAL_MS=30000
