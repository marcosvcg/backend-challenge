        },
        {
          "columnNames": [
            "reference_transaction_id",
            "kind"
          ],
          "composite": true,
          "constraint": false,
          "keyName": "wt_reference_reversal_unique",
          "unique": true,
          "primary": false,
          "expression": "CREATE UNIQUE INDEX wt_reference_reversal_unique ON public.wager_transaction USING btree (reference_transaction_id, kind) WHERE (((status)::text = 'PROCESSED'::text) AND ((kind)::text = ANY ((ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying])::text[])))"
        }
      ],
      "checks": [
        {
          "name": "wt_amount_positive",
          "columnName": "amount",
          "definition": "CHECK ((amount > (0)::numeric))",
          "expression": "amount > 0"
        },
        {
          "name": "wt_currency_format",
          "columnName": "currency",
          "definition": "CHECK (((currency)::text ~ '^[A-Z]{3}$'::text))",
          "expression": "currency ~ '^[A-Z]{3}$'::text"
        },
        {
          "name": "wt_failure_code_coherence",
          "columnName": "status",
          "definition": "CHECK (((((status)::text = ANY ((ARRAY['REJECTED'::character varying, 'FAILED'::character varying])::text[])) AND (failure_code IS NOT NULL)) OR (((status)::text <> ALL ((ARRAY['REJECTED'::character varying, 'FAILED'::character varying])::text[])) AND (failure_code IS NULL))))",
          "expression": "((status = ANY (ARRAY['REJECTED'::character varying, 'FAILED'::character varying][])) AND failure_code IS NOT NULL)) OR (((status <> ALL (ARRAY['REJECTED'::character varying, 'FAILED'::character varying][])) AND (failure_code IS NULL))"
        },
        {
          "name": "wt_next_retry_coherence",
          "columnName": "status",
          "definition": "CHECK (((((status)::text = 'PENDING_REFERENCE'::text) AND (next_reference_retry_at IS NOT NULL)) OR (((status)::text <> 'PENDING_REFERENCE'::text) AND (next_reference_retry_at IS NULL))))",
          "expression": "((status = 'PENDING_REFERENCE'::text) AND next_reference_retry_at IS NOT NULL)) OR (((status <> 'PENDING_REFERENCE'::text) AND (next_reference_retry_at IS NULL))"
        },
        {
          "name": "wt_opening_always_processed",
          "columnName": "kind",
          "definition": "CHECK ((((kind)::text <> 'OPENING'::text) OR ((status)::text = 'PROCESSED'::text)))",
          "expression": "(kind <> 'OPENING'::text) OR (status = 'PROCESSED'::text)"
        },
        {
          "name": "wt_pending_reference_only_when_unresolved",
          "columnName": "reference_transaction_id",
          "definition": "CHECK (((((status)::text = 'PENDING_REFERENCE'::text) AND ((kind)::text = ANY ((ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying])::text[])) AND (reference_transaction_id IS NULL)) OR ((status)::text <> 'PENDING_REFERENCE'::text)))",
          "expression": "((status = 'PENDING_REFERENCE'::text) AND (kind = ANY (ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying][])) AND reference_transaction_id IS NULL)) OR ((status <> 'PENDING_REFERENCE'::text)"
        },
        {
          "name": "wt_processed_at_only_when_processed",
          "columnName": "status",
          "definition": "CHECK (((((status)::text = 'PROCESSED'::text) AND (processed_at IS NOT NULL)) OR (((status)::text <> 'PROCESSED'::text) AND (processed_at IS NULL))))",
          "expression": "((status = 'PROCESSED'::text) AND processed_at IS NOT NULL)) OR (((status <> 'PROCESSED'::text) AND (processed_at IS NULL))"
        },
        {
          "name": "wt_reference_required_by_kind",
          "columnName": "reference_external_transaction_id",
          "definition": "CHECK (((((kind)::text = ANY ((ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying])::text[])) AND (reference_external_transaction_id IS NOT NULL)) OR ((kind)::text = 'WIN'::text) OR (((kind)::text = ANY ((ARRAY['BET'::character varying, 'LOSS'::character varying, 'OPENING'::character varying])::text[])) AND (reference_external_transaction_id IS NULL))))",
          "expression": "((kind = ANY (ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying][])) AND reference_external_transaction_id IS NOT NULL)) OR ((kind = 'WIN'::text) OR ((kind = ANY (ARRAY['BET'::character varying, 'LOSS'::character varying, 'OPENING'::character varying][])) AND (reference_external_transaction_id IS NULL))"
        },
        {
          "name": "wt_reference_retry_attempts_nonneg",
          "columnName": "reference_retry_attempts",
          "definition": "CHECK ((reference_retry_attempts >= 0))",
          "expression": "reference_retry_attempts >= 0"
        },
        {
          "name": "wt_reference_transaction_only_when_applicable",
          "columnName": "kind",
          "definition": "CHECK (((reference_transaction_id IS NULL) OR ((kind)::text = ANY ((ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying, 'WIN'::character varying])::text[]))))",
          "expression": "reference_transaction_id IS NULL) OR ((kind = ANY (ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying, 'WIN'::character varying][]))"
        },
        {
          "name": "wt_result_balance_coherence",
          "columnName": "status",
          "definition": "CHECK (((((status)::text = ANY ((ARRAY['PENDING'::character varying, 'PENDING_REFERENCE'::character varying, 'FAILED'::character varying])::text[])) AND (result_balance_amount IS NULL) AND (result_balance_currency IS NULL)) OR (((status)::text = ANY ((ARRAY['PROCESSED'::character varying, 'REJECTED'::character varying])::text[])) AND (result_balance_amount IS NOT NULL) AND (result_balance_currency IS NOT NULL))))",
          "expression": "((status = ANY (ARRAY['PENDING'::character varying, 'PENDING_REFERENCE'::character varying, 'FAILED'::character varying][])) AND result_balance_amount IS NULL) AND (result_balance_currency IS NULL)) OR (((status = ANY (ARRAY['PROCESSED'::character varying, 'REJECTED'::character varying][])) AND (result_balance_amount IS NOT NULL) AND (result_balance_currency IS NOT NULL))"
        },
        {
          "name": "wt_result_balance_currency_format",
          "columnName": "result_balance_currency",
          "definition": "CHECK (((result_balance_currency IS NULL) OR ((result_balance_currency)::text ~ '^[A-Z]{3}$'::text)))",
          "expression": "result_balance_currency IS NULL) OR ((result_balance_currency ~ '^[A-Z]{3}$'::text)"
        }
