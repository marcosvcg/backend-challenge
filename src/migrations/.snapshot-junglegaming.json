          "expression": "CREATE INDEX wt_pending_reference_worker_idx ON public.wager_transaction USING btree (next_reference_retry_at) WHERE ((status)::text = 'PENDING_REFERENCE'::text)"
        },
        {
          "columnNames": [
            "provider_id",
            "external_transaction_id"
          ],
